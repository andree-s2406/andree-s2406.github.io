---
import type { ProjectScreenshot } from '../data/projects';
import { withBase } from '../utils/url';

interface Props {
  screenshots: ProjectScreenshot[];
  projectName: string;
}

const { screenshots, projectName } = Astro.props;
---

<section class="gallery-wrap" data-gallery aria-label="Galería de capturas">
  <ul class="gallery-grid">
    {screenshots.map((shot, index) => (
      <li>
        <button
          type="button"
          class="shot-card"
          data-shot-index={index}
          data-shot-src={withBase(shot.src)}
          data-shot-title={shot.title}
          data-shot-caption={shot.caption}
          aria-label={`Ampliar captura: ${shot.title}`}
        >
          <img
            src={withBase(shot.src)}
            alt={`${projectName} — ${shot.title}`}
            loading="lazy"
          />
          <span class="shot-title">{shot.title}</span>
          <span class="shot-caption">{shot.caption}</span>
        </button>
      </li>
    ))}
  </ul>

  <dialog class="lightbox" id="gallery-lightbox" aria-label="Visor de capturas">
    <header class="lightbox-top">
      <span class="lightbox-counter" id="lb-counter"></span>
      <button type="button" class="lightbox-close" id="lb-close" aria-label="Cerrar visor">
        Cerrar (Esc)
      </button>
    </header>
    <figure class="lightbox-stage">
      <button type="button" class="lightbox-nav" id="lb-prev" aria-label="Captura anterior">←</button>
      <img id="lb-img" src="" alt="" />
      <button type="button" class="lightbox-nav" id="lb-next" aria-label="Siguiente captura">→</button>
      <figcaption class="lightbox-caption">
        <strong id="lb-title"></strong>
        <span id="lb-desc"></span>
      </figcaption>
    </figure>
  </dialog>
</section>

<style>
  .gallery-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 680px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .shot-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    text-align: left;
    padding: 0 0 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    color: inherit;
    transition: border-color 0.18s ease;
  }

  .shot-card:hover {
    border-color: var(--accent);
  }

  .shot-card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-bottom: 1px solid var(--border);
  }

  .shot-title {
    padding: 0.9rem 1.1rem 0.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .shot-caption {
    padding: 0 1.1rem;
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .lightbox {
    width: min(1040px, 95vw);
    max-height: 92vh;
    padding: 1rem 1.25rem 1.25rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    color: var(--text-primary);
  }

  .lightbox::backdrop {
    background: rgba(6, 8, 11, 0.88);
  }

  .lightbox-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  .lightbox-counter {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
  }

  .lightbox-close {
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
    font-family: var(--font-mono);
  }

  .lightbox-stage {
    position: relative;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .lightbox-stage img {
    max-height: 64vh;
    width: auto;
    object-fit: contain;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .lightbox-nav {
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--bg);
    color: var(--text-primary);
    font-size: 1.1rem;
  }

  #lb-prev { left: 0.75rem; }
  #lb-next { right: 0.75rem; }

  .lightbox-caption {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .lightbox-caption strong { font-size: 0.98rem; }
  .lightbox-caption span { font-size: 0.88rem; color: var(--text-secondary); }
</style>

<script>
  const gallery = document.querySelector('[data-gallery]');
  if (gallery) {
    const cards = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-shot-index]'));
    const dialog = gallery.querySelector<HTMLDialogElement>('#gallery-lightbox');
    const lbImg = gallery.querySelector<HTMLImageElement>('#lb-img');
    const lbTitle = gallery.querySelector<HTMLElement>('#lb-title');
    const lbDesc = gallery.querySelector<HTMLElement>('#lb-desc');
    const lbCounter = gallery.querySelector<HTMLElement>('#lb-counter');
    const btnClose = gallery.querySelector<HTMLButtonElement>('#lb-close');
    const btnPrev = gallery.querySelector<HTMLButtonElement>('#lb-prev');
    const btnNext = gallery.querySelector<HTMLButtonElement>('#lb-next');

    let currentIndex = 0;

    const showShot = (index: number) => {
      if (!cards.length || !lbImg || !lbTitle || !lbDesc || !lbCounter) return;
      currentIndex = (index + cards.length) % cards.length;
      const card = cards[currentIndex];
      lbImg.src = card.dataset.shotSrc || '';
      lbImg.alt = card.dataset.shotTitle || '';
      lbTitle.textContent = card.dataset.shotTitle || '';
      lbDesc.textContent = card.dataset.shotCaption || '';
      lbCounter.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
    };

    cards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        showShot(idx);
        dialog?.showModal();
      });
    });

    btnClose?.addEventListener('click', () => dialog?.close());
    btnPrev?.addEventListener('click', () => showShot(currentIndex - 1));
    btnNext?.addEventListener('click', () => showShot(currentIndex + 1));

    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    document.addEventListener('keydown', (e) => {
      if (!dialog?.open) return;
      if (e.key === 'ArrowLeft') showShot(currentIndex - 1);
      if (e.key === 'ArrowRight') showShot(currentIndex + 1);
    });
  }
</script>
