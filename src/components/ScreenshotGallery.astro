---
import type { ProjectScreenshot } from '../data/projects';
import { withBase } from '../utils/url';

interface Props {
  screenshots: ProjectScreenshot[];
  projectName: string;
}

const { screenshots, projectName } = Astro.props;
---

<div class="gallery-wrap" data-gallery>
  <div class="gallery-grid">
    {screenshots.map((shot, index) => (
      <button
        type="button"
        class="shot-card"
        data-shot-index={index}
        data-shot-src={withBase(shot.src)}
        data-shot-title={shot.title}
        data-shot-caption={shot.caption}
        aria-label={`Ampliar captura: ${shot.title}`}
      >
        <div class="shot-frame">
          <img
            src={withBase(shot.src)}
            alt={`${projectName} — ${shot.title}`}
            loading="lazy"
          />
          <span class="shot-zoom">Ampliar</span>
        </div>
        <div class="shot-meta">
          <span class="shot-index">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <strong>{shot.title}</strong>
            <p>{shot.caption}</p>
          </div>
        </div>
      </button>
    ))}
  </div>

  <dialog class="lightbox" id="gallery-lightbox" aria-label="Visor de capturas">
    <div class="lightbox-inner">
      <div class="lightbox-top">
        <span class="lightbox-counter" id="lb-counter"></span>
        <button type="button" class="lightbox-close" id="lb-close" aria-label="Cerrar visor">
          Cerrar (Esc)
        </button>
      </div>
      <div class="lightbox-stage">
        <button type="button" class="lightbox-nav" id="lb-prev" aria-label="Captura anterior">←</button>
        <img id="lb-img" src="" alt="" />
        <button type="button" class="lightbox-nav" id="lb-next" aria-label="Siguiente captura">→</button>
      </div>
      <div class="lightbox-caption">
        <strong id="lb-title"></strong>
        <p id="lb-desc"></p>
      </div>
    </div>
  </dialog>
</div>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 680px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .shot-card {
    display: flex;
    flex-direction: column;
    text-align: left;
    padding: 0;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    color: inherit;
    transition: transform 0.22s var(--ease-out), border-color 0.22s ease;
  }

  .shot-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  .shot-frame {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--bg);
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .shot-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.35s var(--ease-out);
  }

  .shot-card:hover .shot-frame img {
    transform: scale(1.02);
  }

  .shot-zoom {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.28rem 0.6rem;
    border-radius: 6px;
    background: hsla(220, 14%, 5%, 0.85);
    color: var(--text-primary);
    border: 1px solid var(--border-strong);
    opacity: 0.9;
  }

  .shot-meta {
    display: flex;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
  }

  .shot-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    padding-top: 0.15rem;
  }

  .shot-meta strong {
    display: block;
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
    color: var(--text-primary);
  }

  .shot-meta p {
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Lightbox */
  .lightbox {
    width: min(1040px, 95vw);
    max-height: 92vh;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    color: var(--text-primary);
  }

  .lightbox::backdrop {
    background: rgba(6, 8, 11, 0.85);
    backdrop-filter: blur(8px);
  }

  .lightbox-inner {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.25rem 1.25rem;
    gap: 0.85rem;
  }

  .lightbox-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .lightbox-counter {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
  }

  .lightbox-close {
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-strong);
    border-radius: 7px;
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
    font-family: var(--font-mono);
  }

  .lightbox-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .lightbox-stage img {
    max-height: 64vh;
    width: auto;
    object-fit: contain;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: hsla(220, 14%, 5%, 0.8);
    color: var(--text-primary);
    font-size: 1.1rem;
  }

  #lb-prev { left: 0.75rem; }
  #lb-next { right: 0.75rem; }

  .lightbox-caption strong {
    display: block;
    font-size: 0.98rem;
    margin-bottom: 0.2rem;
  }

  .lightbox-caption p {
    font-size: 0.88rem;
    color: var(--text-secondary);
  }
</style>

<script>
  const gallery = document.querySelector('[data-gallery]');
  if (gallery) {
    const cards = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-shot-index]'));
    const dialog = gallery.querySelector<HTMLDialogElement>('#gallery-lightbox');
    const lbImg = gallery.querySelector<HTMLImageElement>('#lb-img');
    const lbTitle = gallery.querySelector<HTMLElement>('#lb-title');
    const lbDesc = gallery.querySelector<HTMLElement>('#lb-desc');
    const lbCounter = gallery.querySelector<HTMLElement>('#lb-counter');
    const btnClose = gallery.querySelector<HTMLButtonElement>('#lb-close');
    const btnPrev = gallery.querySelector<HTMLButtonElement>('#lb-prev');
    const btnNext = gallery.querySelector<HTMLButtonElement>('#lb-next');

    let currentIndex = 0;

    const showShot = (index: number) => {
      if (!cards.length || !lbImg || !lbTitle || !lbDesc || !lbCounter) return;
      currentIndex = (index + cards.length) % cards.length;
      const card = cards[currentIndex];
      lbImg.src = card.dataset.shotSrc || '';
      lbImg.alt = card.dataset.shotTitle || '';
      lbTitle.textContent = card.dataset.shotTitle || '';
      lbDesc.textContent = card.dataset.shotCaption || '';
      lbCounter.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
    };

    cards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        showShot(idx);
        dialog?.showModal();
      });
    });

    btnClose?.addEventListener('click', () => dialog?.close());
    btnPrev?.addEventListener('click', () => showShot(currentIndex - 1));
    btnNext?.addEventListener('click', () => showShot(currentIndex + 1));

    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    document.addEventListener('keydown', (e) => {
      if (!dialog?.open) return;
      if (e.key === 'ArrowLeft') showShot(currentIndex - 1);
      if (e.key === 'ArrowRight') showShot(currentIndex + 1);
    });
  }
</script>
