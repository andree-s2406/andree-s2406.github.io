---
import { DESPAX_MODULES } from '../data/projects';
---

<section class="explorer" data-despax-explorer aria-label="Módulos técnicos de Despax">
  <nav class="explorer-tabs" role="tablist">
    {DESPAX_MODULES.map((mod, idx) => (
      <button
        type="button"
        role="tab"
        class:list={['explorer-tab', { 'is-active': idx === 0 }]}
        id={`tab-${mod.id}`}
        aria-selected={idx === 0 ? 'true' : 'false'}
        aria-controls={`panel-${mod.id}`}
        data-tab-target={mod.id}
      >
        {mod.label}
      </button>
    ))}
  </nav>

  {DESPAX_MODULES.map((mod, idx) => (
    <article
      role="tabpanel"
      id={`panel-${mod.id}`}
      aria-labelledby={`tab-${mod.id}`}
      class:list={['explorer-panel', { 'is-active': idx === 0 }]}
      hidden={idx !== 0}
      data-tab-panel={mod.id}
    >
      <p class="panel-summary">{mod.summary}</p>

      <dl class="panel-columns">
        <dt>Impacto operativo</dt>
        <dd>{mod.businessValue}</dd>
        <dt class="tech-term">Arquitectura técnica</dt>
        <dd class="tech-def">{mod.technicalDetail}</dd>
      </dl>

      <ul class="chip-list">
        {mod.stack.map((tech) => (
          <li class="chip">{tech}</li>
        ))}
      </ul>
    </article>
  ))}
</section>

<style>
  .explorer {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .explorer-tabs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  @media (min-width: 860px) {
    .explorer-tabs {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .explorer-tab {
    padding: 0.95rem 1.15rem;
    background: transparent;
    border: none;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    text-align: left;
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 500;
    transition: background-color 0.18s ease, color 0.18s ease;
    position: relative;
  }

  @media (min-width: 860px) {
    .explorer-tab { border-bottom: none; }
    .explorer-tab:last-child { border-right: none; }
  }

  .explorer-tab:hover {
    color: var(--text-primary);
    background: var(--bg-elevated);
  }

  .explorer-tab.is-active {
    background: var(--bg-card);
    color: var(--text-primary);
    font-weight: 600;
  }

  .explorer-tab.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--accent);
  }

  .explorer-panel {
    padding: 1.5rem;
  }

  @media (min-width: 768px) {
    .explorer-panel { padding: 2rem; }
  }

  .panel-summary {
    font-size: 1.08rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    max-width: 66ch;
  }

  .panel-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem 2rem;
    margin: 0 0 1.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 768px) {
    .panel-columns {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
      grid-auto-flow: column;
    }
  }

  .panel-columns dt {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .panel-columns dt.tech-term {
    color: var(--accent);
    margin-top: 1rem;
  }

  @media (min-width: 768px) {
    .panel-columns dt.tech-term { margin-top: 0; }
  }

  .panel-columns dd {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>

<script>
  document.querySelectorAll('[data-despax-explorer]').forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-tab-target]');
    const panels = root.querySelectorAll<HTMLElement>('[data-tab-panel]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tabTarget;
        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', String(active));
        });
        panels.forEach((p) => {
          const active = p.dataset.tabPanel === target;
          p.classList.toggle('is-active', active);
          p.hidden = !active;
        });
      });
    });
  });
</script>
