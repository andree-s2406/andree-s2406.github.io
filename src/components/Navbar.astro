---
import { PROFILE } from '../data/projects';
import { withBase } from '../utils/url';

const currentPath = Astro.url.pathname;
const navItems = [
  { label: 'Despax', href: withBase('proyectos/despax/') },
  { label: 'Proyectos', href: `${withBase('')}#proyectos` },
  { label: 'Stack', href: `${withBase('')}#stack` },
  { label: 'Sobre mí', href: `${withBase('')}#sobre-mi` },
  { label: 'Contacto', href: `${withBase('')}#contacto` },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href={withBase('')} class="brand" aria-label={`${PROFILE.name} — Inicio`}>
      <span class="brand-mark">{PROFILE.monogram}</span>
      <span class="brand-text">
        <span class="brand-name">{PROFILE.name}</span>
        <span class="brand-handle">{PROFILE.handle}</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      {navItems.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a href={item.href} class:list={['nav-link', { 'is-active': isActive }]}>
            {item.label}
          </a>
        );
      })}
      <a
        href={PROFILE.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-github"
        aria-label="Perfil de GitHub"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>GitHub</span>
      </a>
    </nav>

    <button
      type="button"
      class="menu-toggle"
      id="mobile-menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-drawer"
      aria-label="Abrir menú de navegación"
    >
      <span class="menu-line"></span>
      <span class="menu-line"></span>
    </button>
  </div>

  <div class="mobile-drawer" id="mobile-drawer" hidden>
    <nav class="mobile-nav" aria-label="Navegación móvil">
      {navItems.map((item) => (
        <a href={item.href} class="mobile-nav-link">
          {item.label}
        </a>
      ))}
      <a
        href={PROFILE.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link mobile-nav-github"
      >
        GitHub ({PROFILE.handle}) →
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: hsla(220, 14%, 5%, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
  }

  .brand-mark {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--bg);
    background: var(--text-primary);
    transition: background-color 0.2s ease;
  }

  .brand:hover .brand-mark {
    background: var(--accent);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .brand-handle {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-link {
    font-size: 0.88rem;
    color: var(--text-secondary);
    padding: 0.45rem 0.75rem;
    border-radius: 7px;
    transition: color 0.18s ease, background-color 0.18s ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--text-primary);
    background: hsla(40, 24%, 93%, 0.05);
  }

  .nav-github {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 7px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-primary);
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .nav-github:hover {
    background: var(--bg-card-hover);
    border-color: hsla(40, 24%, 93%, 0.28);
  }

  .menu-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    border-radius: 9px;
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    padding: 0;
  }

  .menu-line {
    width: 18px;
    height: 1.5px;
    background: var(--text-primary);
    border-radius: 2px;
    transition: transform 0.22s var(--ease-out);
  }

  .menu-toggle[aria-expanded='true'] .menu-line:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-line:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .mobile-drawer {
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
    padding: 0.75rem 1.25rem 1.25rem;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    padding: 0.85rem 0.75rem;
    border-radius: 8px;
    font-size: 1rem;
    color: var(--text-secondary);
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .mobile-nav-link:hover {
    background: hsla(40, 24%, 93%, 0.05);
    color: var(--text-primary);
  }

  .mobile-nav-github {
    margin-top: 0.35rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }

  @media (min-width: 820px) {
    .desktop-nav {
      display: flex;
    }
    .menu-toggle,
    .mobile-drawer {
      display: none !important;
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer');

  if (toggle && drawer) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      drawer.hidden = expanded;
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        drawer.hidden = true;
      });
    });
  }
</script>
