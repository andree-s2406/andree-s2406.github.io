---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoGallery from '../../components/VideoGallery.astro';
import { PROFILE, PROJECTS } from '../../data/projects';
import { withBase } from '../../utils/url';

const { digiteca } = PROJECTS;
---

<BaseLayout
  title={`${digiteca.name} — Proyecto | ${PROFILE.name}`}
  description={digiteca.tagline}
>
  <article class="case-study container">
    <nav class="breadcrumb" aria-label="Ruta de navegación">
      <a href={withBase('')}>← Volver al portafolio</a>
      <span>/</span>
      <span>{digiteca.name}</span>
    </nav>

    <header class="case-header">
      <p class="meta-line">{digiteca.role} · {digiteca.status}</p>
      <hgroup class="title-with-icon">
        {digiteca.iconUrl && (
          <img
            src={withBase(digiteca.iconUrl)}
            alt="Logo de Digiteca"
            width="48"
            height="48"
            class="title-icon"
          />
        )}
        <h1>{digiteca.name}</h1>
      </hgroup>
      <p class="case-tagline">{digiteca.tagline}</p>

      <nav class="case-actions" aria-label="Enlaces de Digiteca">
        {digiteca.liveUrl && (
          <a href={digiteca.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Abrir sitio en vivo ↗
          </a>
        )}
        {digiteca.repoUrl && (
          <a href={digiteca.repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Ver código en GitHub ↗
          </a>
        )}
      </nav>
      <p class="repo-note">{digiteca.repoVisibilityNote}</p>
    </header>

    <section class="case-section grid-2 reveal">
      <article class="info-box">
        <h2>Qué necesidad resuelve</h2>
        <p>{digiteca.problem}</p>
      </article>
      <article class="info-box">
        <h2>Plataforma desarrollada</h2>
        <p>{digiteca.solution}</p>
      </article>
    </section>

    <section class="case-section reveal">
      <h2 class="section-heading">Lo que ofrece la biblioteca digital</h2>
      <ol class="highlights-grid">
        {digiteca.highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ol>
    </section>

    <section class="case-section grid-2 reveal">
      <article class="info-box">
        <h2>Cómo está construido</h2>
        <ul class="arch-list">
          {digiteca.architecture.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </article>
      <article class="info-box">
        <h2>Tecnologías utilizadas</h2>
        <ul class="chip-list">
          {digiteca.stack.map((tech) => (
            <li class="chip">{tech}</li>
          ))}
        </ul>
      </article>
    </section>

    <section class="case-section reveal" id="demo">
      <h2 class="section-heading">Video demo en funcionamiento</h2>
      <VideoGallery videos={digiteca.screenshots} projectName={digiteca.name} />
    </section>
  </article>
</BaseLayout>

<style>
  .case-study { padding: 2.25rem 0 3rem; }

  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }

  .breadcrumb a { color: var(--text-secondary); }
  .breadcrumb a:hover { color: var(--accent); }

  .case-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .title-with-icon {
    margin-top: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .title-icon {
    background: transparent;
    border: none;
    object-fit: contain;
    clip-path: circle(48%);
  }

  .case-header h1 { font-size: clamp(2rem, 4.4vw, 3.1rem); }

  .case-tagline {
    margin-top: 0.75rem;
    font-size: clamp(1rem, 1.7vw, 1.16rem);
    color: var(--text-secondary);
    max-width: 60ch;
  }

  .case-actions {
    margin-top: 1.35rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .repo-note {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .case-section {
    margin-top: 2.5rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--border);
  }

  .section-heading {
    font-size: clamp(1.35rem, 2.5vw, 1.8rem);
    margin-bottom: 1.25rem;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .grid-2 { grid-template-columns: 1fr 1fr; gap: 2.25rem; }
  }

  .info-box {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .info-box h2 { font-size: 1.25rem; }
  .info-box p { color: var(--text-secondary); font-size: 0.94rem; }

  .highlights-grid {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem 2rem;
    color: var(--text-secondary);
    font-size: 0.93rem;
  }

  @media (min-width: 720px) {
    .highlights-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .arch-list {
    margin: 0;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    color: var(--text-secondary);
    font-size: 0.92rem;
  }
</style>
