---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DespaxExplorer from '../../components/DespaxExplorer.astro';
import ScreenshotGallery from '../../components/ScreenshotGallery.astro';
import { PROFILE, PROJECTS, DESPAX_VIDEOS } from '../../data/projects';
import { withBase } from '../../utils/url';

const { despax } = PROJECTS;
---

<BaseLayout
  title={`${despax.name} — Caso de estudio | ${PROFILE.name}`}
  description={despax.tagline}
>
  <article class="case-study container">
    <nav class="breadcrumb" aria-label="Ruta de navegación">
      <a href={withBase('')}>← Volver al portafolio</a>
      <span>/</span>
      <span>{despax.name}</span>
    </nav>

    <header class="case-header">
      <p class="meta-line">{despax.role} · {despax.status}</p>
      <h1>{despax.name}</h1>
      <p class="case-tagline">{despax.tagline}</p>

      <nav class="case-actions" aria-label="Enlaces de Despax">
        {despax.liveUrl && (
          <a href={despax.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Abrir aplicación en producción ↗
          </a>
        )}
      </nav>
      <p class="repo-note">{despax.repoVisibilityNote}</p>
    </header>

    <section class="case-section grid-2 reveal">
      <article class="info-box">
        <h2>Por qué hacía falta Despax</h2>
        <p>{despax.problem}</p>
      </article>
      <article class="info-box">
        <h2>Cómo lo resuelve</h2>
        <p>{despax.solution}</p>
      </article>
    </section>

    <section class="case-section reveal">
      <h2 class="section-heading">Funcionalidades implementadas</h2>
      <ol class="highlights-grid">
        {despax.highlights.map((item) => (
          <li class="highlight-item">{item}</li>
        ))}
      </ol>
    </section>

    <section class="case-section reveal">
      <h2 class="section-heading">Explorador técnico e impacto operativo</h2>
      <DespaxExplorer />
    </section>

    <section class="case-section grid-2 reveal">
      <article class="info-box">
        <h2>Decisiones de ingeniería y seguridad</h2>
        <ul class="arch-list">
          {despax.architecture.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </article>
      <article class="info-box">
        <h2>Tecnologías utilizadas</h2>
        <ul class="chip-list">
          {despax.stack.map((tech) => (
            <li class="chip">{tech}</li>
          ))}
        </ul>
      </article>
    </section>

    <section class="case-section reveal">
      <header class="videos-head">
        <hgroup>
          <h2>Videos explicativos en la página oficial</h2>
          <p class="videos-desc">
            La landing oficial de Despax incluye 7 videos explicativos que muestran cada flujo operativo en funcionamiento real:
          </p>
        </hgroup>
        {despax.liveUrl && (
          <a href={despax.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Ver videos en Despax ↗
          </a>
        )}
      </header>
      <ul class="videos-list">
        {DESPAX_VIDEOS.map((video) => (
          <li>{video}</li>
        ))}
      </ul>
    </section>

    <section class="case-section reveal" id="galeria">
      <h2 class="section-heading">Capturas reales de la última versión ({despax.screenshots.length} pantallas)</h2>
      <ScreenshotGallery screenshots={despax.screenshots} projectName={despax.name} />
    </section>
  </article>
</BaseLayout>

<style>
  .case-study { padding: 2.25rem 0 3rem; }

  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }

  .breadcrumb a { color: var(--text-secondary); }
  .breadcrumb a:hover { color: var(--accent); }

  .case-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .case-header h1 {
    margin-top: 0.45rem;
    font-size: clamp(2.1rem, 4.8vw, 3.4rem);
  }

  .case-tagline {
    margin-top: 0.75rem;
    font-size: clamp(1rem, 1.7vw, 1.18rem);
    color: var(--text-secondary);
    max-width: 60ch;
  }

  .case-actions {
    margin-top: 1.35rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .repo-note {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .case-section {
    margin-top: 2.75rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--border);
  }

  .section-heading {
    font-size: clamp(1.35rem, 2.5vw, 1.8rem);
    margin-bottom: 1.25rem;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .grid-2 { grid-template-columns: 1fr 1fr; gap: 2.25rem; }
  }

  .info-box {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .info-box h2 { font-size: 1.25rem; }
  .info-box p { color: var(--text-secondary); font-size: 0.94rem; }

  .highlights-grid {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem 2rem;
  }

  @media (min-width: 720px) {
    .highlights-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .highlight-item {
    font-size: 0.93rem;
    color: var(--text-secondary);
  }

  .arch-list {
    margin: 0;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .videos-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .videos-head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .videos-head h2 { font-size: clamp(1.3rem, 2.4vw, 1.65rem); }

  .videos-desc {
    margin-top: 0.45rem;
    color: var(--text-secondary);
    font-size: 0.94rem;
    max-width: 62ch;
  }

  .videos-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.65rem;
  }

  @media (min-width: 720px) {
    .videos-list { grid-template-columns: repeat(2, 1fr); }
  }

  .videos-list li {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-secondary);
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
  }
</style>
