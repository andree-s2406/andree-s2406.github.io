---
import BaseLayout from '../layouts/BaseLayout.astro';
import DespaxExplorer from '../components/DespaxExplorer.astro';
import { PROFILE, PROJECTS, VERIFIED_STACK } from '../data/projects';
import { withBase } from '../utils/url';

const { despax, sorbeBeauty, digiteca } = PROJECTS;
---

<BaseLayout
  title={`${PROFILE.name} — ${PROFILE.role}`}
  description="Portafolio de Andrés Rodríguez, desarrollador backend. Despax (proyecto principal), Sorbe Beauty y Digiteca."
>
  <!-- HERO -->
  <section class="hero container">
    <article class="hero-copy">
      <p class="meta-line">{PROFILE.role}</p>
      <h1 class="hero-title">{PROFILE.headline}</h1>
      <p class="hero-sub">{PROFILE.subheadline}</p>
      <nav class="hero-actions" aria-label="Acciones principales">
        <a href={withBase('proyectos/despax/')} class="btn btn-primary">
          Ver Despax (Principal) →
        </a>
        <a href="#proyectos" class="btn btn-secondary">
          Otros proyectos
        </a>
      </nav>
    </article>

    <aside class="hero-index" aria-label="Índice de proyectos">
      <header class="index-header">
        <span>Proyectos en producción</span>
        <span>03</span>
      </header>
      <a href={withBase('proyectos/despax/')} class="index-row index-row--featured">
        <strong>01 · {despax.name}</strong>
        <span>Backend Python, PDFs, Webhooks & Extensión Chrome</span>
      </a>
      <a href={withBase('proyectos/sorbe-beauty/')} class="index-row">
        <strong>02 · {sorbeBeauty.name}</strong>
        <span>Backend PHP 8.2, Reservas Realtime & PWA</span>
      </a>
      <a href={withBase('proyectos/digiteca/')} class="index-row">
        <strong>03 · {digiteca.name}</strong>
        <span>Backend Node.js, PDF.js Seguro & RBAC</span>
      </a>
    </aside>
  </section>

  <!-- DESPAX SPOTLIGHT -->
  <section class="section container reveal" id="despax">
    <header class="section-head">
      <hgroup>
        <p class="meta-line">Proyecto principal · {despax.status}</p>
        <h2>Despax — Automatización de despachos y stock</h2>
      </hgroup>
      <nav class="section-head-actions" aria-label="Enlaces de Despax">
        {despax.liveUrl && (
          <a href={despax.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            App en producción ↗
          </a>
        )}
        <a href={withBase('proyectos/despax/')} class="btn btn-primary">
          Caso de estudio completo →
        </a>
      </nav>
    </header>

    <article class="despax-spotlight">
      <section class="despax-narrative">
        <p class="despax-lead">{despax.summary}</p>
        <dl class="despax-dl">
          <dt>El problema</dt>
          <dd>{despax.problem}</dd>
          <dt>La solución</dt>
          <dd>{despax.solution}</dd>
        </dl>
        <ul class="chip-list">
          {despax.stack.slice(0, 8).map((tech) => (
            <li class="chip">{tech}</li>
          ))}
        </ul>
      </section>

      <figure class="despax-figure">
        <video
          src={withBase(despax.screenshots[0].src)}
          controls
          preload="metadata"
          playsinline
          aria-label="Video demo de Despax — Rotulado, diagnóstico y visor en vivo"
        ></video>
        <figcaption>
          <span>{despax.screenshots.length} videos explicativos en HD</span>
          <a href={withBase('proyectos/despax/#galeria')}>Ver todos los videos →</a>
        </figcaption>
      </figure>
    </article>

    <section class="despax-explorer-wrap" aria-label="Arquitectura modular de Despax">
      <h3>Arquitectura por módulos</h3>
      <DespaxExplorer />
    </section>
  </section>

  <!-- OTROS PROYECTOS -->
  <section class="section container reveal" id="proyectos">
    <header class="section-head">
      <h2>Sorbe Beauty & Digiteca</h2>
    </header>

    <section class="projects-grid" aria-label="Otros proyectos destacados">
      <article class="project-card">
        <header class="project-header">
          {sorbeBeauty.iconUrl && (
            <img
              src={withBase(sorbeBeauty.iconUrl)}
              alt="Ícono de Sorbe Beauty"
              class="project-icon"
              width="38"
              height="38"
            />
          )}
          <hgroup>
            <p class="meta-line">{sorbeBeauty.role}</p>
            <h3>{sorbeBeauty.name}</h3>
          </hgroup>
        </header>

        <p class="project-summary">{sorbeBeauty.summary}</p>

        <ul class="project-bullets">
          {sorbeBeauty.highlights.slice(0, 4).map((item) => (
            <li>{item}</li>
          ))}
        </ul>

        <ul class="chip-list">
          {sorbeBeauty.stack.slice(0, 6).map((tech) => (
            <li class="chip">{tech}</li>
          ))}
        </ul>

        <nav class="project-card-actions" aria-label="Acciones de Sorbe Beauty">
          <a href={withBase('proyectos/sorbe-beauty/')} class="btn btn-primary">
            Ver detalle →
          </a>
          {sorbeBeauty.liveUrl && (
            <a href={sorbeBeauty.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              Sitio en vivo ↗
            </a>
          )}
        </nav>
      </article>

      <article class="project-card">
        <header class="project-header">
          {digiteca.iconUrl && (
            <img
              src={withBase(digiteca.iconUrl)}
              alt="Logo de Digiteca"
              class="project-icon project-icon--circle"
              width="42"
              height="42"
            />
          )}
          <hgroup>
            <p class="meta-line">{digiteca.role}</p>
            <h3>{digiteca.name}</h3>
          </hgroup>
        </header>

        <p class="project-summary">{digiteca.summary}</p>

        <ul class="project-bullets">
          {digiteca.highlights.slice(0, 4).map((item) => (
            <li>{item}</li>
          ))}
        </ul>

        <ul class="chip-list">
          {digiteca.stack.slice(0, 6).map((tech) => (
            <li class="chip">{tech}</li>
          ))}
        </ul>

        <nav class="project-card-actions" aria-label="Acciones de Digiteca">
          <a href={withBase('proyectos/digiteca/')} class="btn btn-primary">
            Ver detalle →
          </a>
          {digiteca.liveUrl && (
            <a href={digiteca.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              Sitio en vivo ↗
            </a>
          )}
          {digiteca.repoUrl && (
            <a href={digiteca.repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              GitHub ↗
            </a>
          )}
        </nav>
      </article>
    </section>
  </section>

  <!-- STACK REAL -->
  <section class="section container reveal" id="stack">
    <header class="section-head">
      <h2>Tecnologías que uso en producción</h2>
    </header>

    <section class="stack-grid" aria-label="Stack tecnológico">
      {VERIFIED_STACK.map((category) => (
        <article class="stack-card">
          <h3>{category.group}</h3>
          <ul class="chip-list">
            {category.items.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </section>
  </section>

  <!-- SOBRE MÍ & CONTACTO -->
  <section class="section container reveal about-contact-grid" id="sobre-mi">
    <article class="about-block">
      <h2>Sobre mí</h2>
      {PROFILE.about.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </article>

    <aside class="contact-block" id="contacto">
      <h2>Contacto</h2>
      <p>
        Podés revisar mis repositorios públicos en GitHub o escribirme por correo para hablar sobre backend, arquitectura o proyectos en producción.
      </p>
      <nav class="contact-actions" aria-label="Canales de contacto">
        <a href={`mailto:${PROFILE.email}`} class="btn btn-primary">
          Enviar email
        </a>
        <a href={PROFILE.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          GitHub ({PROFILE.handle}) ↗
        </a>
      </nav>
      <span class="contact-email">{PROFILE.email}</span>
    </aside>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 3.25rem 0 2.75rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
    align-items: start;
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 920px) {
    .hero {
      padding: 4.5rem 0 3.5rem;
      grid-template-columns: 1.2fr 0.85fr;
      gap: 3rem;
      align-items: center;
    }
  }

  .hero-title {
    margin-top: 0.75rem;
    font-size: clamp(2.05rem, 4.4vw, 3.25rem);
    letter-spacing: -0.03em;
    line-height: 1.08;
    max-width: 18ch;
  }

  .hero-sub {
    margin-top: 1.1rem;
    font-size: clamp(0.98rem, 1.4vw, 1.1rem);
    color: var(--text-secondary);
    max-width: 54ch;
  }

  .hero-actions {
    margin-top: 1.65rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-index {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .index-header {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .index-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--border);
    transition: background-color 0.18s ease;
  }

  .index-row:last-child {
    border-bottom: none;
  }

  .index-row:hover {
    background: var(--bg-card);
  }

  .index-row--featured {
    border-left: 2px solid var(--accent);
    background: var(--bg-card);
  }

  .index-row strong {
    font-size: 0.96rem;
    color: var(--text-primary);
  }

  .index-row span {
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  /* Sections */
  .section {
    padding: 3.25rem 0;
    border-bottom: 1px solid var(--border);
  }

  .section:last-of-type {
    border-bottom: none;
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  @media (min-width: 768px) {
    .section-head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .section-head h2 {
    margin-top: 0.35rem;
    font-size: clamp(1.5rem, 2.7vw, 2.05rem);
  }

  .section-head-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  /* Despax Spotlight */
  .despax-spotlight {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 920px) {
    .despax-spotlight {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 2.5rem;
    }
  }

  .despax-lead {
    font-size: 1.02rem;
    color: var(--text-primary);
    line-height: 1.65;
  }

  .despax-dl {
    margin: 1.35rem 0;
    padding: 1.15rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem 1.5rem;
  }

  .despax-dl dt {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin-top: 0.65rem;
  }

  .despax-dl dt:first-child {
    margin-top: 0;
  }

  .despax-dl dd {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .despax-figure {
    margin: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-elevated);
  }

  .despax-figure video {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    display: block;
  }

  .despax-figure figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-secondary);
    border-top: 1px solid var(--border);
  }

  .despax-figure figcaption a {
    color: var(--accent);
  }

  .despax-explorer-wrap {
    margin-top: 2.5rem;
  }

  .despax-explorer-wrap h3 {
    font-size: 1.15rem;
    margin-bottom: 0.9rem;
  }

  /* Other Projects */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 820px) {
    .projects-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .project-card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .project-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .despax-logo {
    height: 28px;
    width: auto;
    margin-bottom: 0.65rem;
  }

  .project-icon {
    background: transparent;
    border: none;
    object-fit: contain;
    flex-shrink: 0;
  }

  .project-icon--circle {
    clip-path: circle(48%);
  }

  .project-card h3 {
    font-size: 1.3rem;
    margin-top: 0.2rem;
  }

  .project-summary {
    color: var(--text-secondary);
    font-size: 0.94rem;
  }

  .project-bullets {
    margin: 0;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: var(--text-secondary);
    font-size: 0.88rem;
  }

  .project-card-actions {
    margin-top: auto;
    padding-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  /* Stack */
  .stack-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .stack-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .stack-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stack-card {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
  }

  .stack-card h3 {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    margin-bottom: 0.85rem;
  }

  /* About & Contact */
  .about-contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 820px) {
    .about-contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .about-block,
  .contact-block {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .about-block h2,
  .contact-block h2 {
    font-size: 1.45rem;
  }

  .about-block p,
  .contact-block p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .contact-email {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    word-break: break-all;
  }
</style>
